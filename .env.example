# Environment Configuration
# Copy this file to .env and update with your actual values

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
PORT=8080

# Firebase Configuration
# Local demo profile requests use only the Auth and Firestore emulators.
FIREBASE_PROJECT_ID=demo-test
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7010
FIRESTORE_EMULATOR_HOST=127.0.0.1:7030
# FIRESTORE_DATABASE=(default)

# Request handling
# CORS_ORIGINS=http://localhost:3000

# Google Application Credentials (path to service account JSON file)
# Optional future hosted setup only: unset both emulator hosts and use your own project.
# Local emulators use anonymous SDK credentials and require no ADC.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
